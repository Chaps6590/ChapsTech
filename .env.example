# Analítica con Umami (opcional). Se leen al hacer el build, no en runtime:
# definilas como variables de entorno del servicio de deploy (Coolify) y redeployá.
# Sin estas dos variables la web no carga ningún script de estadísticas.
#
# VITE_UMAMI_URL  = dirección de tu Umami, sin barra final
# VITE_UMAMI_ID   = "Website ID" que te da Umami al agregar el sitio
VITE_UMAMI_URL=https://stats.chapstech.cloud
VITE_UMAMI_ID=00000000-0000-0000-0000-000000000000
